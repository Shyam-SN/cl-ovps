{
  "schema_version": 1,
  "variables": {
    "flow_dir": "{root}/tools/openroad-flow-scripts/flow",
    "flow_config": "<absolute-path-to-ORFS-DESIGN_CONFIG>",
    "work_home": "{root}/build/orfs_universal/{design}",
    "platform": "sky130hd",
    "setup_margin_ns": "<validated per-design setup repair margin in ns>",
    "pre_global_route_tcl": "{root}/scripts/cl_ovps_clock_leaf_ndr.tcl",
    "design_nickname": "<ORFS-design-nickname>",
    "route_variant": "<unique-route-variant>",
    "cts_variant": "<unique-CTS-variant>",
    "rc_tcl": "{root}/tools/openroad-flow-scripts/flow/platforms/sky130hd/setRC.tcl",
    "stage1_dir": "{output_dir}/stage1",
    "cts_dir": "{output_dir}/cts",
    "stage2_dir": "{output_dir}/stage2",
    "stage3_dir": "{output_dir}/stage3",
    "stage4_dir": "{output_dir}/stage4",
    "route_results": "{work_home}/results/{platform}/{design_nickname}/{route_variant}",
    "route_logs": "{work_home}/logs/{platform}/{design_nickname}/{route_variant}",
    "baseline_netlist": "<absolute-path-to-baseline-final-v-netlist>",
    "lec_plan": "<absolute-path-to-configured-cl_ovps_lec_plan.json>"
  },
  "stages": [
    {
      "name": "stage1",
      "command": [
        "python3", "{root}/scripts/run_cl_ovps_stage1.py",
        "--design", "{design}",
        "--source-odb", "{placed_odb}",
        "--source-sdc", "{sdc}",
        "--flow-dir", "{flow_dir}",
        "--flow-config", "{flow_config}",
        "--work-home", "{work_home}",
        "--platform", "{platform}",
        "--design-nickname", "{design_nickname}",
        "--activity-policy", "global-default",
        "--lib", "{lib}",
        "--rc-tcl", "{rc_tcl}",
        "--output-dir", "{stage1_dir}"
      ],
      "outputs": {
        "optimized_odb": "{stage1_dir}/optimized.odb"
      }
    },
    {
      "name": "stage2",
      "commands": [
        [
          "python3", "{root}/scripts/run_cl_ovps_cts.py",
          "--design", "{design}",
          "--flow-dir", "{flow_dir}",
          "--flow-config", "{flow_config}",
          "--work-home", "{work_home}",
          "--platform", "{platform}",
          "--design-nickname", "{design_nickname}",
          "--placement-odb", "{stage1_optimized_odb}",
          "--placement-sdc", "{sdc}",
          "--variant", "{cts_variant}",
          "--output-dir", "{cts_dir}"
        ],
        [
          "python3", "{root}/scripts/run_cl_ovps_pass.py",
          "--stage", "clock", "--action", "all",
          "--input-odb", "{work_home}/results/{platform}/{design_nickname}/{cts_variant}/4_1_cts.odb",
          "--sdc", "{work_home}/results/{platform}/{design_nickname}/{cts_variant}/4_cts.sdc",
          "--default-activity", "0.1",
          "--lib", "{lib}", "--rc-tcl", "{rc_tcl}",
          "--output-odb", "{stage2_dir}/clock.odb",
          "--report", "{stage2_dir}/clock.tsv",
          "--log", "{stage2_dir}/clock.log"
        ]
      ],
      "outputs": {
        "clock_odb": "{stage2_dir}/clock.odb",
        "cts_sdc": "{work_home}/results/{platform}/{design_nickname}/{cts_variant}/4_cts.sdc"
      }
    },
    {
      "name": "stage3",
      "command": [
        "python3", "{root}/scripts/run_cl_ovps_pass.py",
        "--stage", "sizing", "--action", "all",
        "--input-odb", "{stage2_clock_odb}",
        "--sdc", "{stage2_cts_sdc}",
        "--default-activity", "0.1",
        "--lib", "{lib}", "--rc-tcl", "{rc_tcl}",
        "--output-odb", "{stage3_dir}/sized.odb",
        "--report", "{stage3_dir}/sizing.tsv",
        "--log", "{stage3_dir}/sizing.log"
      ],
      "outputs": {
        "sizing_odb": "{stage3_dir}/sized.odb"
      }
    },
    {
      "name": "stage4",
      "command": [
        "python3", "{root}/scripts/run_cl_ovps_stage4.py",
        "--design", "{design}",
        "--flow-dir", "{flow_dir}",
        "--flow-config", "{flow_config}",
        "--work-home", "{work_home}",
        "--platform", "{platform}",
        "--design-nickname", "{design_nickname}",
        "--source-place-odb", "{stage1_optimized_odb}",
        "--source-place-sdc", "{sdc}",
        "--transformed-odb", "{stage3_sizing_odb}",
        "--cts-sdc", "{stage2_cts_sdc}",
        "--variant", "{route_variant}",
        "--output-dir", "{stage4_dir}",
        "--setup-margin", "{setup_margin_ns}",
        "--pre-global-route-tcl", "{pre_global_route_tcl}",
        "--baseline-netlist", "{baseline_netlist}",
        "--lec-plan", "{lec_plan}"
      ],
      "outputs": {
        "final_odb": "{route_results}/6_final.odb",
        "final_sdc": "{route_results}/6_final.sdc",
        "final_spef": "{route_results}/6_final.spef",
        "stage4_manifest": "{stage4_dir}/stage4_manifest.json"
      }
    }
  ],
  "final": {
    "placed_odb": "{stage4_final_odb}",
    "sdc": "{stage4_final_sdc}",
    "spef": "{stage4_final_spef}"
  },
  "evidence": {
    "route_log": "{route_logs}/5_2_route.log",
    "psm_log": "{route_logs}/6_report.log",
    "lec_status": "{stage4_dir}/lec_status.txt",
    "lec_log": "{stage4_dir}/lec.log"
  }
}
